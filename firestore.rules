rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Her salon hesabı yalnızca kendi UID'si altında bulunan belgeleri
    // okuyabilir veya değiştirebilir.
    match /salons/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
